{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "jetbrains": {
      "type": "sse",
      "url": "http://localhost:64342/sse",
      "enabled": true,
      "headers": {
        "IJ_MCP_SERVER_PROJECT_PATH": "/Users/drsdgdbye/IdeaProjects/a-tes"
      },
      "oauth": false
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect", "--channel=stable", "--no-usage-statistics"],
      "enabled": true
    },
    "docker": {
      "type": "local",
      "command": ["docker", "mcp", "gateway", "run", "--profile", "terminal_control", "--transport", "stdio"],
      "enabled": true,
      "environment": {
        "MCP_GATEWAY_DOCKER_BIND_ALLOW_WRITABLE_PATHS": "/Users/drsdgdbye/IdeaProjects/a-tes"
      }
    }
  }
}
